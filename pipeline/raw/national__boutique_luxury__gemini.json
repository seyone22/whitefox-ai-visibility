              "groundingChunkIndices": [
                0,
                1
              ]
            },
            {
              "segment": {
                "startIndex": 592,
                "endIndex": 742,
                "text": "They completely discarded real estate clichés in favor of punchy copywriting, minimalist monochrome branding, and signature phrases like *\"THE DEAL\"*"
              },
              "groundingChunkIndices": [
                2,
                0,
                1
              ]
            },
            {
              "segment": {
                "startIndex": 746,
                "endIndex": 859,
                "text": "**Video & Social Media Style:** Highly stylized, fast-paced, and designed natively for Instagram Reels and TikTok"
              },
              "groundingChunkIndices": [
                3,
                4,
                1
              ]
            },
            {
              "segment": {
                "startIndex": 861,
                "endIndex": 1046,
                "text": "Their listing videos feature cinematic color grading, punchy voiceover walkthroughs from the agents, and upbeat soundtracks that feel more like lifestyle commercials than property tours"
              },
              "groundingChunkIndices": [
                0
              ]
            },
            {
              "segment": {
                "startIndex": 1051,
                "endIndex": 1219,
                "text": "**Architectural Profile:** Contemporary concrete and glass architectural builds, designer Mornington Peninsula coastal pavilions, and high-spec urban luxury renovations"
              },
              "groundingChunkIndices": [
                2,
                5
              ]
            },
            {
              "segment": {
                "startIndex": 1313,
                "endIndex": 1422,
                "text": "**The Reputation:** BresicWhitney was the pioneer of design-led, editorial real estate marketing in Australia"
              },
              "groundingChunkIndices": [
                6
              ]
            },
            {
              "segment": {
