            },
            {
              "segment": {
                "startIndex": 3647,
                "endIndex": 3819,
                "text": "**Architectural Profile:** Sculptural concrete beachfront pavilions (Mermaid Beach, Palm Beach), expansive riverfront estates, and high-spec minimalist coastal architecture"
              },
              "groundingChunkIndices": [
                17,
                19
              ]
            },
            {
              "segment": {
                "startIndex": 3881,
                "endIndex": 3996,
                "text": "**The Reputation:** Founded by Marcus Lloyd-Jones, Modern House is Australia’s purist architectural estate agency"
              },
              "groundingChunkIndices": [
                20
