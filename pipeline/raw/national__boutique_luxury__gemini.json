          "groundingSupports": [
            {
              "segment": {
                "startIndex": 435,
                "endIndex": 590,
                "text": "**The Reputation:** Founded by Marty Fox, WHITEFOX revolutionized Australian property marketing with an uncompromising, bold, and fashion-forward aesthetic"
