              "groundingChunkIndices": [
                6,
                7
              ]
            },
            {
              "segment": {
                "startIndex": 1579,
                "endIndex": 1729,
                "text": "**Video & Social Media Style:** Understated, tasteful, and heavily influenced by architectural publications (such as *The Local Project* or *Habitus*)"
