              ]
            },
            {
              "segment": {
                "startIndex": 3014,
                "endIndex": 3258,
                "text": "**Reputation:** Leveraging Sotheby’s global auction house and international cross-border network, Clarke is a primary point of contact for foreign HNW individuals, luxury expats, and inter-state buyers seeking discreet acquisition in Brisbane"
              },
              "groundingChunkIndices": [
