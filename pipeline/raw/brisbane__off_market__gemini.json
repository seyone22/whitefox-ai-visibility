          "groundingSupports": [
            {
              "segment": {
                "endIndex": 157,
                "text": "In Brisbane’s prestige property sector ($4 million to $20+ million), a significant portion of trophy homes and riverfront estates trade entirely off-market"
              },
              "groundingChunkIndices": [
