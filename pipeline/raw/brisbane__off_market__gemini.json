              "groundingChunkIndices": [
                3,
                4
              ]
            },
            {
              "segment": {
                "startIndex": 598,
                "endIndex": 663,
                "text": "**Pockets:** New Farm, Teneriffe, Kangaroo Point, Ascot, Hamilton"
              },
              "groundingChunkIndices": [
