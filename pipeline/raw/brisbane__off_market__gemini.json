                "text": "A substantial proportion of his annual transaction volume is handled through private databases and silent off-market campaigns tailored for confidentiality"
              },
              "groundingChunkIndices": [
                15
              ]
            },
            {
              "segment": {
                "startIndex": 2066,
                "endIndex": 2173,
                "text": "**Pockets:** New Farm, Teneriffe, Ascot, Spring Hill, and landmark architectural properties across Brisbane"
              },
              "groundingChunkIndices": [
                18,
                19
              ]
            },
            {
              "segment": {
